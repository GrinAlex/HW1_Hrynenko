# Варіант 1: Локальна Ollama (модель з підтримкою tool calling: qwen2.5:7b або llama3.1:8b)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Варіант 2: OpenRouter (розкоментуйте, якщо локальна модель слабка або повільна)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-ваш-ключ
# LLM_MODEL=openai/gpt-4o-mini